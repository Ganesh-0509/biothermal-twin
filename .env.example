# =================================================================
# BioThermal Twin - Environment Configuration (.env.example)
# Note: The platform runs 100% offline out-of-the-box using the
# built-in PINN model and local syndromic extraction engine.
# The keys below enable external LLM and live weather integrations.
# =================================================================

# 1. OpenAI API Key (Optional)
# Used for live GPT-4o-mini syndromic extraction and cloud Whisper fallback.
# If omitted, the local rule-based syndromic engine and local Faster-Whisper run offline.
OPENAI_API_KEY=your_openai_api_key_here

# 2. Hugging Face Token / Med42 Inference (Optional)
# Used to query M42's sovereign clinical foundation model (m42-health/med42-70b or med42-8b).
HF_TOKEN=your_huggingface_token_here
MED42_API_URL=https://api-inference.huggingface.co/models/m42-health/med42-8b

# 3. Microclimate & Weather Ingestion (Optional)
# Used if streaming live outdoor WBGT weather telemetry for Abu Dhabi (ICAD / Musaffah)
# instead of the mathematical diurnal environment simulator.
OPENWEATHER_API_KEY=your_openweather_api_key_here
NCMS_STATION_ID=AD-MUSAFFAH-01

# 4. Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://biothermal-twin.vercel.app

# 5. Abu Dhabi Malaffi HIE / Institutional Gate (Conceptual / Restricted)
# Access restricted to certified UAE healthcare entities under DoH / ADPHC regulation.
MALAFFI_FACILITY_ID=
MALAFFI_CLIENT_SECRET=
